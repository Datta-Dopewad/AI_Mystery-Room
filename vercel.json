{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "ai-mystery-room-api": {
      "root": "server",
      "framework": "express",
      "functions": {
        "src/server.js": { "maxDuration": 60 }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "ai-mystery-room-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
